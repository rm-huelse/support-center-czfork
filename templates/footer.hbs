<footer class="rm-footer">
  <div class="container">
    <div class="rm-footer__grid">
      <div class="rm-footer__brand">
        <div class="rm-footer__logo-wrap">
          <img src="{{asset 'crewzone-logo-white.svg'}}" alt="CREWZONE" class="rm-footer__logo">
        </div>
        <p class="rm-footer__tagline">Find your next project. Find your next crew.</p>
        <p class="rm-footer__status">
          <span class="rm-footer__status-dot" id="rm-status-dot"></span>
          <a href="https://status.rentman.io" class="rm-footer__status-link" target="_blank" rel="noopener" id="rm-status-text">System status</a>
        </p>
      </div>
      <div class="rm-footer__col">
        <h4 class="rm-footer__col-title">{{dc 'footer_support_heading'}}</h4>
        <ul class="rm-footer__links">
          {{!-- CREWZONE: by email until the forms are ready. --}}
          <li><a href="mailto:support@crewzone.com">Submit a request</a></li>
          <li><a href="https://status.rentman.io" target="_blank" rel="noopener">System status</a></li>
          <li><a href="https://crewzone.com" target="_blank" rel="noopener">crewzone.com</a></li>
        </ul>
      </div>
    </div>
    <div class="rm-footer__bottom">
      <p class="rm-footer__copy">© <span id="rm-footer-year"></span> CREWZONE. All rights reserved.</p>
      {{#if alternative_locales}}
        <div class="dropdown rm-footer__lang-selector">
          <a class="dropdown-toggle rm-footer__lang-toggle" aria-haspopup="true" aria-expanded="false">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" focusable="false" viewBox="0 0 16 16" aria-hidden="true">
              <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zM1.5 8h13M8 1c-2 2-3 4.5-3 7s1 5 3 7M8 1c2 2 3 4.5 3 7s-1 5-3 7"/>
            </svg>
            {{!-- Zendesk names en-us "English (United States)"; this help centre serves more than the US --}}
            {{#is help_center.locale 'en-us'}}English{{else}}{{current_locale.name}}{{/is}}
          </a>
          <span class="dropdown-menu" role="menu">
            {{#each alternative_locales}}
              <a href="{{url}}" dir="{{direction}}" rel="nofollow" role="menuitem">{{#contains url 'en-us'}}English{{else}}{{name}}{{/contains}}</a>
            {{/each}}
          </span>
        </div>
      {{/if}}
      <nav class="rm-footer__legal" aria-label="Legal links">
        <a href="https://crewzone.com/en_GB/privacy" target="_blank" rel="noopener">Privacy</a>
        <a href="https://crewzone.com/en_GB/terms" target="_blank" rel="noopener">Terms</a>
        <a href="https://crewzone.com/en_GB/imprint" target="_blank" rel="noopener">Imprint</a>
      </nav>
    </div>
  </div>
</footer>
<script>
(function () {
  var yr = document.getElementById('rm-footer-year');
  if (yr) yr.textContent = new Date().getFullYear();
  var dot  = document.getElementById('rm-status-dot');
  var stxt = document.getElementById('rm-status-text');
  if (dot && stxt) {
    // Statuspage's own description says "Partial System Outage" whenever the
    // indicator is 'major', which understates a critical incident. Derive the
    // wording here instead, and take the worse of the overall indicator and any
    // unresolved incident so the footer never contradicts the notification bar.
    var RANK  = { none: 0, minor: 1, major: 2, critical: 3 };
    var LABEL = ['All systems operational', 'Degraded performance', 'Partial outage', 'Major outage'];
    var CLASS = ['ok', 'minor', 'major', 'critical'];
    var show = function (level) {
      dot.className = 'rm-footer__status-dot rm-footer__status-dot--' + CLASS[level];
      stxt.textContent = LABEL[level];
    };
    Promise.all([
      fetch('https://status.rentman.io/api/v2/status.json').then(function (r) { return r.json(); }),
      fetch('https://status.rentman.io/api/v2/incidents/unresolved.json').then(function (r) { return r.json(); })
    ]).then(function (res) {
      var level = RANK[res[0].status && res[0].status.indicator] || 0;
      var list  = res[1].incidents || [];
      for (var i = 0; i < list.length; i++) {
        var r = RANK[list[i].impact] || 0;
        if (r > level) { level = r; }
      }
      show(level);
    }).catch(function () { show(0); });
  }
}());
</script>
